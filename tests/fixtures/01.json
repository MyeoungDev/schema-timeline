  "views": [
    {
      "name": "order_summary",
      "definition": " SELECT o.id,\n    o.user_id,\n    o.status,\n    count(i.id) AS item_count\n   FROM (orders o\n     LEFT JOIN order_items i ON ((i.order_id = o.id)))\n  GROUP BY o.id, o.user_id, o.status;"
    }
